{
  "key": "jni-bridge",
  "label": "JNI bridge / RegisterNatives mapping",
  "maturity": "synthetic-e2e",
  "routeTrack": "jni-bridge",
  "signals": [
    "jni_onload",
    "registernatives",
    "system.loadlibrary",
    "java_",
    "native"
  ],
  "protocol": "references/jni-bridge-playbook.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/jni-bridge.json",
  "taskInit": {
    "aliases": [
      "jni"
    ],
    "baseProtectionTier": "A4"
  },
  "taskSemantics": {
    "presentPath": "jniBridge.present",
    "versionPath": "jniBridge.version",
    "artifactsPath": "jniBridge.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
      "jniBridge.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "jniBridge.present",
    "requiredArtifacts": [
      "run/register-natives-trace.js",
      "run/jni-bridge-map.md"
    ],
    "requirementsAll": [
      {
        "message": "jniBridge.present=true but status is still not-started",
        "path": "jniBridge.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "jniBridge.present=true but keyFindings is still empty",
        "path": "jniBridge.keyFindings",
        "minLength": 1
      },
      {
        "message": "jniBridge.present=true but artifacts are still placeholders",
        "touchedAny": [
          "run/register-natives-trace.js",
          "run/jni-bridge-map.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/android-jni-bridge-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/register-natives-trace.js",
    "artifacts/tasks/_TEMPLATE/run/jni-bridge-map.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "JNI",
    "RegisterNatives",
    "run/register-natives-trace.js",
    "run/jni-bridge-map.md"
  ],
  "owner": "android-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/jni-bridge"
}

