{
  "key": "native-network",
  "label": "Native network / Cronet / BoringSSL / QUIC",
  "maturity": "closed-loop",
  "routeTrack": "native-network",
  "signals": [
    "cronet",
    "boringssl",
    "ssl_ctx",
    "x509",
    "quic",
    "native tls"
  ],
  "protocol": "references/native-network-playbook.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/native-network.json",
  "taskInit": {
    "aliases": [
      "cronet",
      "tls"
    ],
    "baseProtectionTier": "A3"
  },
  "taskSemantics": {
    "presentPath": "nativeNetwork.present",
    "artifactsPath": "nativeNetwork.artifacts",
    "minArtifacts": 1,
    "arrayPaths": [
      "nativeNetwork.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "nativeNetwork.present",
    "requiredArtifacts": [
      "run/network-stack-notes.md"
    ],
    "requirementsAll": [
      {
        "message": "nativeNetwork.present=true but status is still not-started",
        "path": "nativeNetwork.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "nativeNetwork.present=true but keyFindings is still empty",
        "path": "nativeNetwork.keyFindings",
        "minLength": 1
      },
      {
        "message": "nativeNetwork.present=true but network-stack notes are still placeholders",
        "touchedAny": [
          "run/network-stack-notes.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/android-native-network-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/network-stack-notes.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "Native Network",
    "run/network-stack-notes.md"
  ],
  "owner": "android-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/native-network"
}
