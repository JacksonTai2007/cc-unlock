          "not-started"
        ]
      },
      {
        "message": "frameworkRuntime.present=true but keyFindings is still empty",
        "path": "frameworkRuntime.keyFindings",
        "minLength": 1
      },
      {
        "message": "frameworkRuntime.present=true but framework-runtime notes are still placeholder",
        "touchedAny": [
          "run/framework-runtime-notes.md"
        ]
      },
      {
        "message": "frameworkRuntime.present=true but framework-runtime map is still placeholder",
        "touchedAny": [
          "run/framework-runtime-map.json"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/android-framework-runtime-workflow.mjs"
  ],
  "templateArtifacts": [
