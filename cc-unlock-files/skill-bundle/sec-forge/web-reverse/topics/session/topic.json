{
  "key": "session",
  "label": "Session lifecycle",
  "maturity": "closed-loop",
  "routeTrack": "session",
  "signals": [
    "session",
    "bootstrap",
    "token refresh",
    "cookie"
  ],
  "protocol": "references/session-lifecycle-playbook.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/session.json",
  "taskInit": {
    "aliases": [
      "session-lifecycle"
    ],
    "baseProtectionTier": "T0",
    "combinationProtectionTiers": []
  },
  "taskSemantics": {
    "presentPath": "sessionLifecycle.present",
    "versionPath": "sessionLifecycle.version",
    "artifactsPath": "sessionLifecycle.artifacts",
    "minArtifacts": 1
  },
  "formalValidation": {
    "presentPath": "sessionLifecycle.present",
    "requiredArtifacts": [
      "run/session-notes.md"
    ],
    "requirementsAll": [
      {
        "message": "sessionLifecycle.present=true but bootstrapStatus is still not-started",
        "path": "sessionLifecycle.bootstrapStatus",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "sessionLifecycle.present=true but session artifacts are still placeholders",
        "touchedAny": [
          "run/session-notes.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/web-session-lifecycle-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/session-notes.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    },
    {
      "path": "tools/qa/check-task-semantics.mjs",
      "needles": [
        "validateTopicSemantics",
        "readTopicRegistry"
      ]
    }
  ],
  "outputNeedles": [
    "bootstrap",
    "cookie / storage / memory / worker / frame",
    "run/session-notes.md"
  ],
  "owner": "web-reverse-core",
  "riskLevel": "medium",
  "requiredChecks": [
    "check:topic-manifests",
    "check:task-semantics",
    "check:task-packs",
    "check:capability-coverage",
    "check:specialized-strength",
    "check:deliverables",
    "check:route-consistency"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/session",
  "extendedProtocols": [
    "references/websearch-escalation-playbook.md"
  ]
}
