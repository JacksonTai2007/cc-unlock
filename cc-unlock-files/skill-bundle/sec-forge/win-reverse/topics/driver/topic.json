{
  "key": "driver",
  "label": "Kernel driver / dispatch / ioctl",
  "maturity": "synthetic-e2e",
  "routeTrack": "driver",
  "signals": [
    "sys",
    "driverentry",
    "dispatch",
    "ioctl",
    "irp",
    "deviceiocontrol"
  ],
  "protocol": "references/driver.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/driver.json",
  "taskInit": {
    "aliases": [
      "sys-driver"
    ],
    "baseProtectionTier": "T0"
  },
  "taskSemantics": {
    "presentPath": "driverAnalysis.present",
    "versionPath": "driverAnalysis.version",
    "artifactsPath": "driverAnalysis.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
      "driverAnalysis.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "driverAnalysis.present",
    "requiredArtifacts": [
      "run/driver-dispatch-map.md",
      "run/kernel-ioctl-map.md"
    ],
    "requirementsAll": [
      {
        "message": "driverAnalysis.present=true but status is still not-started",
        "path": "driverAnalysis.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "driverAnalysis.present=true but keyFindings is still empty",
        "path": "driverAnalysis.keyFindings",
        "minLength": 1
      },
      {
        "message": "driverAnalysis.present=true but artifacts are still placeholders",
        "touchedAny": [
          "run/driver-dispatch-map.md",
          "run/kernel-ioctl-map.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/win-driver-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/driver-dispatch-map.md",
    "artifacts/tasks/_TEMPLATE/run/kernel-ioctl-map.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "IOCTL",
    "DriverEntry",
    "run/driver-dispatch-map.md",
    "run/kernel-ioctl-map.md"
  ],
  "owner": "win-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/driver"
}
