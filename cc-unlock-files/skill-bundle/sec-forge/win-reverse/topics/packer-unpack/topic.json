{
  "key": "packer-unpack",
  "label": "Packer / OEP / dump / IAT rebuild",
  "maturity": "synthetic-e2e",
  "routeTrack": "packer-unpack",
  "signals": [
    "packer",
    "oep",
    "dump",
    "iat",
    "stub",
    "rwx"
  ],
  "protocol": "references/packers.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/packer-unpack.json",
  "taskInit": {
    "aliases": [
      "unpack"
    ],
    "baseProtectionTier": "T0"
  },
  "taskSemantics": {
    "presentPath": "packerUnpack.present",
    "versionPath": "packerUnpack.version",
    "artifactsPath": "packerUnpack.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
      "packerUnpack.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "packerUnpack.present",
    "requiredArtifacts": [
      "run/unpack-notes.md",
      "run/iat-rebuild-notes.md"
    ],
    "requirementsAll": [
      {
        "message": "packerUnpack.present=true but status is still not-started",
        "path": "packerUnpack.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "packerUnpack.present=true but keyFindings is still empty",
        "path": "packerUnpack.keyFindings",
        "minLength": 1
      },
      {
        "message": "packerUnpack.present=true but artifacts are still placeholders",
        "touchedAny": [
          "run/unpack-notes.md",
          "run/iat-rebuild-notes.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/win-packer-unpack-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/unpack-notes.md",
    "artifacts/tasks/_TEMPLATE/run/iat-rebuild-notes.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "OEP",
    "IAT",
    "run/unpack-notes.md",
    "run/iat-rebuild-notes.md"
  ],
  "owner": "win-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/packer-unpack"
}
