{
  "key": "ui-runtime",
  "label": "UI runtime / WndProc / dialog flow",
  "maturity": "synthetic-e2e",
  "routeTrack": "ui-runtime",
  "signals": [
    "wndproc",
    "dialog",
    "user32",
    "message",
    "subclass",
    "custom-control"
  ],
  "protocol": "references/ui.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/ui-runtime.json",
  "taskInit": {
    "aliases": [
      "wndproc"
    ],
    "baseProtectionTier": "T0"
  },
  "taskSemantics": {
    "presentPath": "uiRuntime.present",
    "versionPath": "uiRuntime.version",
    "artifactsPath": "uiRuntime.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
      "uiRuntime.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "uiRuntime.present",
    "requiredArtifacts": [
      "run/ui-runtime-notes.md",
      "run/message-flow.md"
    ],
    "requirementsAll": [
      {
        "message": "uiRuntime.present=true but status is still not-started",
        "path": "uiRuntime.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "uiRuntime.present=true but keyFindings is still empty",
        "path": "uiRuntime.keyFindings",
        "minLength": 1
      },
      {
        "message": "uiRuntime.present=true but artifacts are still placeholders",
        "touchedAny": [
          "run/ui-runtime-notes.md",
          "run/message-flow.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/win-ui-runtime-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/ui-runtime-notes.md",
    "artifacts/tasks/_TEMPLATE/run/message-flow.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "WndProc",
    "消息",
    "run/ui-runtime-notes.md",
    "run/message-flow.md"
  ],
  "owner": "win-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/ui-runtime"
}
