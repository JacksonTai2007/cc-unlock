{
  "key": "webview-hybrid",
  "label": "WebView / hybrid bridge / JS-Native boundary",
  "maturity": "closed-loop",
  "routeTrack": "webview-hybrid",
  "signals": [
    "webview",
    "addjavascriptinterface",
    "evaluatejavascript",
    "hybrid",
    "webchromeclient"
  ],
  "protocol": "references/webview-hybrid-playbook.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/webview-hybrid.json",
  "taskInit": {
    "aliases": [
      "webview",
      "hybrid"
    ],
    "baseProtectionTier": "A2"
  },
  "taskSemantics": {
    "presentPath": "webview.present",
    "artifactsPath": "webview.artifact",
    "minArtifacts": 1,
    "arrayPaths": [
      "webview.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "webview.present",
    "requiredArtifacts": [
      "run/webview-bridge-notes.md"
    ],
    "requirementsAll": [
      {
        "message": "webview.present=true but status is still not-started",
        "path": "webview.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "webview.present=true but keyFindings is still empty",
        "path": "webview.keyFindings",
        "minLength": 1
      },
      {
        "message": "webview.present=true but webview notes are still placeholders",
        "touchedAny": [
          "run/webview-bridge-notes.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/android-webview-hybrid-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/webview-bridge-notes.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "WebView",
    "run/webview-bridge-notes.md"
  ],
  "owner": "android-reverse-core",
  "riskLevel": "medium",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/webview-hybrid"
}
