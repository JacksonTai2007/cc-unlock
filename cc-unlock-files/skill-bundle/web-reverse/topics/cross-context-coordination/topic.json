    "requiredArtifacts": [
      "run/context-map.md",
      "run/message-graph.json"
    ],
    "requirementsAll": [
      {
        "message": "crossContextCoordination.present=true but coordinationStatus is still not-started",
        "path": "crossContextCoordination.coordinationStatus",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "crossContextCoordination.present=true but contexts is still empty",
        "path": "crossContextCoordination.contexts",
        "minLength": 1
      },
      {
        "message": "crossContextCoordination.present=true but cross-context artifacts are still placeholders",
        "touchedAny": [
          "run/context-map.md",
          "run/message-graph.json"
        ]
      }
    ],
    "requirementsAny": [
      {
        "message": "crossContextCoordination.present=true but channel / timing status is still unknown",
        "checks": [
          {
            "path": "crossContextCoordination.channelStatus",
            "disallow": [
              "unknown",
              "not-started"
            ]
          },
          {
            "path": "crossContextCoordination.timingStatus",
            "disallow": [
              "unknown",
              "not-started"
            ]
          }
        ]
      }
    ]
  },
  "caseFiles": [
