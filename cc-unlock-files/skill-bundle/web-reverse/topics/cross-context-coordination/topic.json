  "taskSemantics": {
    "presentPath": "crossContextCoordination.present",
    "versionPath": "crossContextCoordination.version",
    "artifactsPath": "crossContextCoordination.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
