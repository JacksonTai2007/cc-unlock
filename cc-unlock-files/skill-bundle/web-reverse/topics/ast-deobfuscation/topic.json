    ],
    "baseProtectionTier": "T2",
    "combinationProtectionTiers": [
      {
        "withTopics": [
          "dynamic-code"
        ],
        "tier": "T3"
      }
    ]
  },
  "taskSemantics": {
    "presentPath": "astDeobfuscation.present",
    "versionPath": "astDeobfuscation.version",
    "artifactsPath": "astDeobfuscation.artifacts",
    "minArtifacts": 4,
    "arrayPaths": [
      "astDeobfuscation.obfuscationFamilies"
