  },
  "formalValidation": {
    "presentPath": "astDeobfuscation.present",
    "requiredArtifacts": [
      "run/before.js",
      "run/after.js",
      "run/deobf-rules.md",
      "run/ast-transform.mjs"
    ],
    "requirementsAll": [
      {
        "message": "astDeobfuscation.present=true but transformStatus is still not-started",
        "path": "astDeobfuscation.transformStatus",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "astDeobfuscation.present=true but obfuscationFamilies is still empty",
        "path": "astDeobfuscation.obfuscationFamilies",
        "minLength": 1
      },
      {
        "message": "astDeobfuscation.present=true but AST artifacts are still placeholders",
        "touchedAny": [
          "run/before.js",
          "run/after.js",
          "run/deobf-rules.md",
          "run/ast-transform.mjs"
        ]
      }
    ],
    "requirementsAny": [
      {
        "message": "astDeobfuscation.present=true but runtime evidence / confidence is still unknown",
        "checks": [
          {
            "path": "astDeobfuscation.runtimeEvidenceStatus",
            "disallow": [
              "unknown",
              "not-started"
            ]
          },
          {
            "path": "astDeobfuscation.semanticConfidence",
            "disallow": [
              "unknown"
            ]
          }
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/web-ast-deobfuscation-workflow.mjs"
  ],
  "templateArtifacts": [
