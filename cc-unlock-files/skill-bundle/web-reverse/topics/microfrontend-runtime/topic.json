{
  "key": "microfrontend-runtime",
  "label": "Microfrontend runtime / remote loader",
  "maturity": "closed-loop",
  "routeTrack": "microfrontend-runtime",
  "signals": [
    "System.import",
    "importmap",
    "single-spa",
    "qiankun",
    "remote manifest",
    "subapp mount"
  ],
  "protocol": "references/microfrontend-runtime-playbook.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/microfrontend-runtime.json",
  "taskInit": {
    "aliases": [
      "microfrontend",
      "remote-loader"
    ],
    "baseProtectionTier": "T2",
    "combinationProtectionTiers": [
      {
        "withTopics": [
          "bundle-loader",
          "framework-runtime"
        ],
        "tier": "T3"
      }
    ]
  },
  "taskSemantics": {
    "presentPath": "microfrontendRuntime.present",
    "versionPath": "microfrontendRuntime.version",
    "artifactsPath": "microfrontendRuntime.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
      "microfrontendRuntime.subapps"
    ]
  },
  "formalValidation": {
    "presentPath": "microfrontendRuntime.present",
    "requiredArtifacts": [
      "run/runtime-map.json",
      "run/remote-deps.md"
    ],
    "requirementsAll": [
      {
        "message": "microfrontendRuntime.present=true but loaderStatus is still not-started",
        "path": "microfrontendRuntime.loaderStatus",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "microfrontendRuntime.present=true but subapps is still empty",
        "path": "microfrontendRuntime.subapps",
        "minLength": 1
      },
      {
        "message": "microfrontendRuntime.present=true but microfrontend artifacts are still placeholders",
        "touchedAny": [
          "run/runtime-map.json",
          "run/remote-deps.md"
        ]
      }
    ],
    "requirementsAny": [
      {
        "message": "microfrontendRuntime.present=true but share scope / sandbox status is still unknown",
        "checks": [
          {
            "path": "microfrontendRuntime.shareScopeStatus",
            "disallow": [
              "unknown",
              "not-started"
            ]
          },
          {
            "path": "microfrontendRuntime.sandboxStatus",
            "disallow": [
              "unknown",
              "not-started"
            ]
          }
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/web-microfrontend-runtime-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/runtime-map.json",
    "artifacts/tasks/_TEMPLATE/run/remote-deps.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    },
    {
      "path": "tools/qa/check-task-semantics.mjs",
      "needles": [
        "validateTopicSemantics",
        "readTopicRegistry"
      ]
    }
  ],
  "outputNeedles": [
    "single-spa",
    "run/runtime-map.json",
    "run/remote-deps.md"
  ],
  "owner": "web-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:task-semantics",
    "check:task-packs",
    "check:capability-coverage",
    "check:specialized-strength",
    "check:deliverables",
    "check:route-consistency"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/microfrontend-runtime",
  "extendedProtocols": [
    "references/websearch-escalation-playbook.md"
  ]
}
