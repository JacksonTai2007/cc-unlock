{
  "key": "dotnet",
  "label": ".NET / CLR / IL patching",
  "maturity": "synthetic-e2e",
  "routeTrack": "dotnet",
  "signals": [
    "clr",
    "il",
    "metadata",
    "confuserex",
    "delegate",
    "dynamicmethod"
  ],
  "protocol": "references/dotnet.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/dotnet.json",
  "taskInit": {
    "aliases": [
      "clr"
    ],
    "baseProtectionTier": "T0"
  },
  "taskSemantics": {
    "presentPath": "dotnetAnalysis.present",
    "versionPath": "dotnetAnalysis.version",
    "artifactsPath": "dotnetAnalysis.artifacts",
    "minArtifacts": 2,
    "arrayPaths": [
      "dotnetAnalysis.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "dotnetAnalysis.present",
    "requiredArtifacts": [
      "run/dotnet-notes.md",
      "run/il-patch-notes.md"
    ],
    "requirementsAll": [
      {
        "message": "dotnetAnalysis.present=true but status is still not-started",
        "path": "dotnetAnalysis.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "dotnetAnalysis.present=true but keyFindings is still empty",
        "path": "dotnetAnalysis.keyFindings",
        "minLength": 1
      },
      {
        "message": "dotnetAnalysis.present=true but artifacts are still placeholders",
        "touchedAny": [
          "run/dotnet-notes.md",
          "run/il-patch-notes.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/win-dotnet-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/dotnet-notes.md",
    "artifacts/tasks/_TEMPLATE/run/il-patch-notes.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    ".NET",
    "CLR",
    "run/dotnet-notes.md",
    "run/il-patch-notes.md"
  ],
  "owner": "win-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/dotnet"
}
