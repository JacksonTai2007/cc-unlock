{
  "key": "config-recovery",
  "label": "Config / blob / persistence recovery",
  "maturity": "synthetic-e2e",
  "routeTrack": "config-recovery",
  "signals": [
    "config",
    "resourceblob",
    "registry",
    "service",
    "blob",
    "decryptor"
  ],
  "protocol": "references/config-recovery.md",
  "taskModelFile": "artifacts/tasks/_TEMPLATE/extensions/config-recovery.json",
  "taskInit": {
    "aliases": [
      "config",
      "blob-recovery"
    ],
    "baseProtectionTier": "T1"
  },
  "taskSemantics": {
    "presentPath": "configRecovery.present",
    "versionPath": "configRecovery.version",
    "artifactsPath": "configRecovery.artifacts",
    "minArtifacts": 3,
    "arrayPaths": [
      "configRecovery.keyFindings"
    ]
  },
  "formalValidation": {
    "presentPath": "configRecovery.present",
    "requiredArtifacts": [
      "run/config-recovery-notes.md",
      "run/config-schema.md",
      "run/blob-decode-notes.md"
    ],
    "requirementsAll": [
      {
        "message": "configRecovery.present=true but status is still not-started",
        "path": "configRecovery.status",
        "disallow": [
          "not-started"
        ]
      },
      {
        "message": "configRecovery.present=true but keyFindings is still empty",
        "path": "configRecovery.keyFindings",
        "minLength": 1
      },
      {
        "message": "configRecovery.present=true but artifacts are still placeholders",
        "touchedAny": [
          "run/config-recovery-notes.md",
          "run/config-schema.md",
          "run/blob-decode-notes.md"
        ]
      }
    ]
  },
  "caseFiles": [
    "scripts/cases/win-config-recovery-workflow.mjs"
  ],
  "templateArtifacts": [
    "artifacts/tasks/_TEMPLATE/run/config-recovery-notes.md",
    "artifacts/tasks/_TEMPLATE/run/config-schema.md",
    "artifacts/tasks/_TEMPLATE/run/blob-decode-notes.md"
  ],
  "qaFiles": [
    {
      "path": "tools/task/validation.mjs",
      "needles": [
        "evaluateTopicFormalValidation",
        "evaluateTopicPhaseGuards"
      ]
    }
  ],
  "outputNeedles": [
    "配置",
    "资源",
    "run/config-recovery-notes.md",
    "run/config-schema.md"
  ],
  "owner": "win-reverse-core",
  "riskLevel": "high",
  "requiredChecks": [
    "check:topic-manifests",
    "check:capability-coverage",
    "check:operating-contracts",
    "check:deliverables"
  ],
  "taskPackDir": "artifacts/tasks/_TEMPLATE/topic-packs/config-recovery"
}
