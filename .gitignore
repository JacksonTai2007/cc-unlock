# Dependency and generated release trees.
**/node_modules/
**/dist/
**/release/
**/.build-tools/
/.b/
/.build-stage*/
**/.work/
**/PORTABLE_MANIFEST_v*.json

# Disposable runtime profiles, caches and local state; never publish conversations.
**/.runtime/
**/.runtime-profile*/
**/.electron-profile*/
**/.profile*/
**/user-data/
/runtime-profiles/
/profiles/
/sessions/
/archived_sessions/
**/__pycache__/
*.py[cod]
/temp/
/tmp/
*.tmp
*.temp
*.log
.env
.env.*
.DS_Store
Thumbs.db

# Public examples and fixture logs are source inputs, not local credentials/runtime logs.
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.env.*.example
!**/.env.*.template
!**/fixtures/**/*.log

# Installer sources are public inputs, not generated output.
!/scripts/
!/scripts/installer/
!/scripts/installer/*.nsi
