{
  "name": "cc-unlock-codex",
  "productName": "cc-unlock for Codex",
  "version": "2.0.0",
  "description": "cc-unlock for Codex — security research workstation deployer (IBM Carbon)",
  "main": "main.js",
  "author": "JacksonTai",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "node pack.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.ccunlock.codex",
    "productName": "cc-unlock-codex",
    "files": [
      "main.js",
      "preload.js",
      "deploy-core.js",
      "renderer/**/*",
      "bundle/**/*"
    ],
    "extraResources": [
      {
        "from": "../codex-files",
        "to": "codex-files"
      },
      {
        "from": "../cc-unlock-files/skill-bundle",
        "to": "skill-bundle"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
