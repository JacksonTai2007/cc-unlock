{
  "name": "cc-unlock-codex",
  "productName": "cc-unlock for Codex",
  "version": "3.0.1",
  "description": "cc-unlock for codex — local maintenance workbench",
  "main": "main.js",
  "author": "JacksonTai",
  "license": "MIT",
  "scripts": {
    "predist": "node ../scripts/sync-prompts.cjs --write",
    "start": "electron .",
    "dist": "node pack.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.ccunlock.codex",
    "productName": "cc-unlock-codex",
    "files": [
      "main.js",
      "preload.js",
      "deploy-core.js",
      "renderer/**/*",
      "backup-core.js",
      "chat-editor-host.js",
      "context-host.js",
      "context-worker.js",
      "lock-delete-state.js",
      "maintenance-log.js"
    ],
    "extraResources": [
      {
        "from": "../codex-files/codex-config-bundle",
        "to": "codex-files/codex-config-bundle"
      },
      {
        "from": "../cc-unlock-files/skill-bundle",
        "to": "skill-bundle"
      },
      {
        "from": "chat-editor",
        "to": "chat-editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
