{
  "name": "cc-unlock-claude",
  "productName": "cc-unlock for Claude Code",
  "version": "2.0.0",
  "description": "cc-unlock for Claude Code — security research workstation deployer (IBM Carbon)",
  "main": "main.js",
  "author": "JacksonTai",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "node pack.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.ccunlock.claude",
    "productName": "cc-unlock-claude",
    "files": [
      "main.js",
      "preload.js",
      "deploy-core.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../cc-unlock-files/memory-bundle",
        "to": "memory-bundle"
      },
      {
        "from": "../cc-unlock-files/skill-bundle",
        "to": "skill-bundle"
      },
      {
        "from": "../cc-unlock-files/config-bundle",
        "to": "config-bundle"
      },
      {
        "from": "bundle",
        "to": "claude-bundle"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
